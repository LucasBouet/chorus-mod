<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Game path: NO path is hardcoded here.
    Resolution order:
      1. ChorusMod.user.props (local file, ignored by git)   <- recommended
      2. CLONEHERO_DIR environment variable
      3. -p:CloneHeroDir=... on the command line
      4. platform-plausible default (last resort)
  -->
  <Import Project="ChorusMod.user.props" Condition="Exists('ChorusMod.user.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ChorusMod</AssemblyName>
    <RootNamespace>ChorusMod</RootNamespace>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 2. Environment variable -->
    <CloneHeroDir Condition="'$(CloneHeroDir)' == '' And '$(CLONEHERO_DIR)' != ''">$(CLONEHERO_DIR)</CloneHeroDir>

    <!-- 4. Platform-plausible defaults -->
    <CloneHeroDir Condition="'$(CloneHeroDir)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">C:\Program Files (x86)\Steam\steamapps\common\Clone Hero</CloneHeroDir>
    <CloneHeroDir Condition="'$(CloneHeroDir)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.local/share/Steam/steamapps/common/Clone Hero</CloneHeroDir>
    <CloneHeroDir Condition="'$(CloneHeroDir)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/Clone Hero</CloneHeroDir>

    <!--
      MSBuild accepts forward slashes on every platform and converts them
      as needed: no backslash is ever written here.
    -->
    <BepInExDir>$(CloneHeroDir)/BepInEx</BepInExDir>
    <InteropDir>$(BepInExDir)/interop</InteropDir>
    <BepInExCoreDir>$(BepInExDir)/core</BepInExCoreDir>
  </PropertyGroup>

  <!--
    Explicit error message instead of a wall of CS0246 errors when the path
    is wrong: interop assemblies are only generated on the FIRST launch of
    the game with BepInEx installed.
  -->
  <Target Name="VerifyGamePath" BeforeTargets="BeforeBuild">
    <Error
      Condition="!Exists('$(InteropDir)')"
      Text="Interop folder not found: $(InteropDir)%0ASet the game path via ChorusMod.user.props, the CLONEHERO_DIR variable, or -p:CloneHeroDir=...%0AAlso check that the game has been launched at least once with BepInEx: that launch is what generates BepInEx/interop." />
  </Target>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.755" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Private=false: these DLLs already exist on the game's side. Copying
      them into the output would create a duplicate version at load time.
    -->
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCoreDir)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- MonoBehaviour ultimately inherits from Il2CppSystem.Object -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(InteropDir)/Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- OnGUI / GUILayout -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(InteropDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- TextAnchor / FontStyle for GUIStyle -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(InteropDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(InteropDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityWebRequestTexture: album art -->
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(InteropDir)/UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule">
      <HintPath>$(InteropDir)/UnityEngine.UnityWebRequestTextureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ReInput.controllers.Keyboard -->
    <Reference Include="Rewired_Core">
      <HintPath>$(InteropDir)/Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SongScan type -->
    <Reference Include="CloneHero">
      <HintPath>$(InteropDir)/CloneHero.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Toast notifications: our own Canvas/Image/TMP text -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(InteropDir)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(InteropDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(InteropDir)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>$(InteropDir)/UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
